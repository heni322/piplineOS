# Production environment for docker-compose.prod.yml. Copy to .env.prod on the server (chmod 600), fill from your
# secret manager. NEVER commit .env.prod. Everything stays dry-run until the three live keys are on.
VERSION=0.6.0
REGISTRY=pipelineos
APP_DOMAIN=app.example.co.uk
ACME_EMAIL=ops@example.co.uk
PUBLIC_BASE_URL=https://app.example.co.uk
API_BASE_URL=https://app.example.co.uk
LOG_LEVEL=INFO
# Named in our crawler's User-Agent so site owners can reach you (your site or a contact page)
CRAWLER_CONTACT=https://app.example.co.uk

# Database (passwords must match ./secrets/pipelineos_owner and ./secrets/pipelineos_app)
DATABASE_URL=postgresql+psycopg://pipelineos_app:CHANGE_ME@postgres:5432/pipelineos
DATABASE_OWNER_URL=postgresql+psycopg://pipelineos_owner:CHANGE_ME@postgres:5432/pipelineos
DATABASE_BACKUP_URL=postgresql://pipelineos_backup:CHANGE_ME@postgres:5432/pipelineos
VALKEY_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@valkey:6379/0

# Four different 32-byte keys: `pipelineos keys generate`. Back them up OFFLINE, separately from database backups:
# without PII_MASTER_KEY the backups can't be read; SUPPRESSION_HASH_KEY must never change.
PII_MASTER_KEY=
BLIND_INDEX_KEY=
SUPPRESSION_HASH_KEY=
UNSUBSCRIBE_SIGNING_KEY=

GLOBAL_GO_LIVE=false

# Free-only: true = no paid provider is ever built or called, whatever the adapter modes below say.
# - decision-makers: the free Companies House officers list (needs COMPANIES_HOUSE_API_KEY); no email addresses,
#   so those leads become human "published contact" tasks instead of emails
# - email verification: none (every address "unknown")
# - AI in live mode: the free local model at LOCAL_LLM_URL, never the paid API
FREE_ONLY=true
# Free-only: take the generic business address (sales@, info@...) the company publishes on its own website, once a
# page of that site states the company's registered number (robots.txt respected, public hosts only).
WEBSITE_CONTACTS=true
EMAIL_ADAPTER_MODE=mock
CALENDAR_ADAPTER_MODE=mock
CRM_ADAPTER_MODE=mock
ENRICHMENT_ADAPTER_MODE=mock
VERIFIER_ADAPTER_MODE=mock
SIGNALS_ADAPTER_MODE=mock
COMPANIES_HOUSE_ADAPTER_MODE=mock
# France: official company register (recherche-entreprises.api.gouv.fr, free, no key), read-only
FR_REGISTRY_ADAPTER_MODE=mock
LLM_ADAPTER_MODE=mock
# LLM_ADAPTER_MODE=sandbox -> a free local model via Ollama on this machine (testing; no cost, nothing leaves the machine)
# The free local model runs in the `ollama` service (start with --profile local-llm; see docs/LOCAL-LLM.md).
# Choose the model from the server's memory, then confirm with `pipelineos llm benchmark`:
#   16 GB server: gemma4:12b | 32 GB: glm-4.7-flash or gemma4:26b | 48 GB+: qwen3.6:35b | 24 GB GPU: qwen3.6:27b
LOCAL_LLM_URL=http://ollama:11434
LOCAL_LLM_MODEL=glm-4.7-flash
# false = no "thinking" pass (much faster, same JSON quality for these tasks); gpt-oss takes low/medium/high
LOCAL_LLM_THINK=false
LOCAL_LLM_KEEP_ALIVE=24h
LOCAL_LLM_NUM_CTX=8192
# Ollama container: image tag, memory cap (model size + ~4 GB), parallel requests (1 on CPU)
OLLAMA_IMAGE_TAG=0.34.4
OLLAMA_MEM_LIMIT=24g
OLLAMA_NUM_PARALLEL=1
OLLAMA_CPUS=6

COMPANIES_HOUSE_API_KEY=
# Companies House STREAMING key (free; create a separate "streaming" key in the developer hub). With it, a job reads
# the filing stream every FILING_STREAM_INTERVAL_MINUTES and keeps new share allotments (SH01, usually a funding round)
# and new charges (MR01) for the whole UK market; each client with icp.sic_codes gets those in its SIC codes.
COMPANIES_HOUSE_STREAM_KEY=
FILING_STREAM_INTERVAL_MINUTES=5
# Skip triggers from companies being wound up: the Gazette's corporate insolvency notices (free, open) + register status.
INSOLVENCY_FILTER=true
# Trigger hunting (Contracts Finder + Find a Tender award notices: free, public, no key) when SIGNALS_ADAPTER_MODE
# is sandbox or live, plus each client's watchlist (tenant config "watchlist"): its companies' public job boards
# (Greenhouse, Lever, Ashby: free, no key) and, with COMPANIES_HOUSE_API_KEY, new directors on the register.
# is sandbox or live. Every HUNT_INTERVAL_HOURS (0 = off), looking back HUNT_LOOKBACK_DAYS.
HUNT_INTERVAL_HOURS=6
HUNT_LOOKBACK_DAYS=2
# Hunter.io: finds the decision-maker's work email and verifies it (ENRICHMENT/VERIFIER_ADAPTER_MODE).
# Paid: real lookups only with all three live keys; sandbox uses Hunter's free test key; otherwise dry-run log only.
HUNTER_API_KEY=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_WEBHOOK_SECRET=
# Google Workspace (for clients who send from Google): service account with domain-wide delegation, authorised in the
# Workspace admin console for gmail.send, gmail.readonly, calendar.events and calendar.freebusy only.
# Paste the key file's JSON on one line. Replies arrive by Pub/Sub push to https://<your domain>/webhooks/google.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUSH_AUDIENCE=
GOOGLE_PUSH_SERVICE_ACCOUNT=
SYSTEM_MAIL_PROVIDER=msgraph
SYSTEM_MAIL_FROM=no-reply@example.co.uk
SYSTEM_MAIL_NAME=PipelineOS
# Which AI does the live work (FREE_ONLY=true always means the local model):
#   local (free, this server) | anthropic | gemini (both paid, only with the three live keys)
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
# Gemini: use a key on the PAID tier. On the free tier Google uses prompts to improve its products, which is not
# acceptable for prospect data. Prices: config/llm_prices.yaml.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Who finds decision-makers when FREE_ONLY=false: companies_house (free register + the company's published address)
# or hunter (paid). Unset: companies_house with FREE_ONLY=true, hunter otherwise.
ENRICHMENT_PROVIDER=companies_house
# Google Places (paid; docs/GOOGLE-PLACES.md): finds company websites, and new companies by activity and area
# (`pipelineos places discover`). Needs FREE_ONLY=false; real searches only with the three live keys; at most
# PLACES_MONTHLY_CAP billed searches a month (1000 = Google's free monthly allowance for the fields we ask for).
PLACES_ADAPTER_MODE=mock
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_CAP=1000
PLACES_REGION=GB
PLACES_LANGUAGE=en
LLM_LOG_BODIES=false
METRICS_TOKEN=
BACKUP_HOST_DIR=/srv/pipelineos/backups

# Public landing page (/): where pilot enquiries go. A BUILD argument of the web image
# (docker build --build-arg NEXT_PUBLIC_CONTACT_EMAIL=...); leave empty to show no enquiry button.
NEXT_PUBLIC_CONTACT_EMAIL=
