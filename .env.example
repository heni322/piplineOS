# PipelineOS environment. Copy to .env and fill in. NEVER commit .env.
# Everything defaults to SAFE values: mock adapters, dry-run, GLOBAL_GO_LIVE=false.

# dev | test | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Runtime role (NO BYPASSRLS) and migration/owner role. Local Docker publishes Postgres on 5433.
DATABASE_URL=postgresql+psycopg://pipelineos_app:app_dev_only@localhost:5433/pipelineos
DATABASE_OWNER_URL=postgresql+psycopg://pipelineos_owner:owner_dev_only@localhost:5433/pipelineos
REDIS_URL=redis://localhost:6380/0

# Four DIFFERENT 32-byte keys (urlsafe base64). Generate: cd backend && uv run pipelineos keys generate
# PII_MASTER_KEY wraps per-tenant data keys; BLIND_INDEX_KEY for exact-match lookups;
# SUPPRESSION_HASH_KEY for the global suppression list (must never change or rotate without migration);
# UNSUBSCRIBE_SIGNING_KEY signs one-click unsubscribe links.
PII_MASTER_KEY=
BLIND_INDEX_KEY=
SUPPRESSION_HASH_KEY=
UNSUBSCRIBE_SIGNING_KEY=

# Three-key live switch, key 3 of 3. Only allowed in ENVIRONMENT=prod, and real sending ALSO needs
# adapter mode=live, tenant live_mode=true and every go-live checklist item signed off by the operator.
GLOBAL_GO_LIVE=false

# Adapter modes: mock | sandbox | live   (key 1 of 3)
EMAIL_ADAPTER_MODE=mock
CALENDAR_ADAPTER_MODE=mock
CRM_ADAPTER_MODE=mock
ENRICHMENT_ADAPTER_MODE=mock
VERIFIER_ADAPTER_MODE=mock
SIGNALS_ADAPTER_MODE=mock
COMPANIES_HOUSE_ADAPTER_MODE=mock
LLM_ADAPTER_MODE=mock
# LLM_ADAPTER_MODE=sandbox -> a free local model via Ollama on this machine (testing; no cost, nothing leaves the machine)
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b

# Optional until Phase 3 live evals. Leave empty to use mocked/recorded LLM responses only.
ANTHROPIC_API_KEY=
LLM_MODEL_VOLUME=claude-sonnet-5-5
LLM_MODEL_REASONING=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60
# Store encrypted prompt/response bodies in llm_calls (true in dev with synthetic data; decide before prod)
LLM_LOG_BODIES=true

SESSION_IDLE_HOURS_TENANT=12
SESSION_ABSOLUTE_HOURS_OPERATOR=8
# Must be true outside dev/test (HTTPS only cookies)
COOKIE_SECURE=false
SEND_DECISION_MAX_AGE_MINUTES=15
SENDING_RECONCILE_AFTER_MINUTES=10

# ---- Phase 6: real providers (unused while the matching *_ADAPTER_MODE is mock) ----
COMPANIES_HOUSE_API_KEY=
# Trigger hunting (Contracts Finder + Find a Tender award notices: free, public, no key) when SIGNALS_ADAPTER_MODE
# is sandbox or live. Every HUNT_INTERVAL_HOURS (0 = off), looking back HUNT_LOOKBACK_DAYS.
HUNT_INTERVAL_HOURS=6
HUNT_LOOKBACK_DAYS=2
# Hunter.io: finds the decision-maker's work email and verifies it (ENRICHMENT/VERIFIER_ADAPTER_MODE).
# Paid: real lookups only with all three live keys; sandbox uses Hunter's free test key; otherwise dry-run log only.
HUNTER_API_KEY=
# Microsoft 365 app registration (client credentials). Restrict it to the sending mailboxes with an
# Exchange application access policy. Needed for EMAIL/CALENDAR adapter modes sandbox (calendar reads) and live.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
# Random secret; derives the per-mailbox clientState that authenticates Graph change notifications
MSGRAPH_WEBHOOK_SECRET=
# Transactional emails (invites, password resets, invoice notices)
# Google Workspace (for clients who send from Google): service account with domain-wide delegation, authorised in the
# Workspace admin console for gmail.send, gmail.readonly, calendar.events and calendar.freebusy only.
# Paste the key file's JSON on one line. Replies arrive by Pub/Sub push to https://<your domain>/webhooks/google.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUSH_AUDIENCE=
GOOGLE_PUSH_SERVICE_ACCOUNT=
SYSTEM_MAIL_PROVIDER=msgraph
SYSTEM_MAIL_FROM=no-reply@pipelineos.example
SYSTEM_MAIL_NAME=PipelineOS
# Sandbox email goes ONLY to a local SMTP sink (Mailpit); any other host is refused
SANDBOX_SMTP_HOST=mailpit
SANDBOX_SMTP_PORT=1025
# Bearer token Prometheus uses for GET /metrics. Empty = metrics endpoint disabled.
METRICS_TOKEN=
